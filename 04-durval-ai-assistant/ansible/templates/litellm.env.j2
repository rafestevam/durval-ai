# {{ ansible_managed }}
# Lido pelo systemd (EnvironmentFile) do serviço litellm.
LITELLM_MASTER_KEY="{{ vault_litellm_master_key }}"
LITELLM_SALT_KEY="{{ vault_litellm_salt_key }}"
DATABASE_URL="postgresql://{{ litellm_db_user }}:{{ vault_postgresql_litellm_password | urlencode | replace('/', '%2F') }}@127.0.0.1:{{ postgresql_port }}/{{ litellm_db_name }}"
STORE_MODEL_IN_DB="True"

# Console admin em https://{{ durvalai_hostname }}{{ litellm_root_path }}/ui
SERVER_ROOT_PATH="{{ litellm_root_path }}"
PROXY_BASE_URL="https://{{ durvalai_hostname }}{{ litellm_root_path }}"
UI_USERNAME="{{ litellm_ui_username }}"
UI_PASSWORD="{{ vault_litellm_ui_password }}"

# Chaves dos provedores de LLM (os.environ/<NOME> no config.yaml).
{% for name, value in litellm_provider_env.items() if value | length > 0 %}
{{ name }}="{{ value }}"
{% endfor %}
